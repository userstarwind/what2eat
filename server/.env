APP_NAME=what2eat-server
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8080
RELOAD=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_SCHEME=postgresql+asyncpg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=surf
DB_NAME=what2eat
DB_MAINTENANCE_DB=postgres
ECHO_SQL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=5

FOOD_EMBEDDING_STREAM_KEY=stream:food_embedding_jobs
FOOD_EMBEDDING_CONSUMER_GROUP=food-embedding-workers
FOOD_EMBEDDING_CONSUMER_NAME=food-embedding-worker
FOOD_EMBEDDING_WORKER_PROCESSES=1
FOOD_EMBEDDING_READ_COUNT=32
FOOD_EMBEDDING_BLOCK_MS=5000
FOOD_EMBEDDING_STREAM_MAXLEN=10000
FOOD_EMBEDDING_MAX_RETRIES=3



EMBEDDING_DIMENSIONS=1024
USE_CACHE=false

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_HASH_ALGORITHM=pbkdf2_sha256
PASSWORD_HASH_ITERATIONS=390000
PASSWORD_SALT_BYTES=16
