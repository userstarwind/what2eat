APP_NAME=what2eat-server
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8080
RELOAD=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_SCHEME=postgresql+asyncpg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=surf
DB_NAME=what2eat
DB_MAINTENANCE_DB=postgres
ECHO_SQL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SOCKET_TIMEOUT_SECONDS=5

FOOD_EMBEDDING_STREAM_KEY=stream:food_embedding_jobs
FOOD_EMBEDDING_CONSUMER_GROUP=food-embedding-workers
FOOD_EMBEDDING_CONSUMER_NAME=food-embedding-worker
FOOD_EMBEDDING_WORKER_PROCESSES=1
FOOD_EMBEDDING_READ_COUNT=32
FOOD_EMBEDDING_BLOCK_MS=5000
FOOD_EMBEDDING_STREAM_MAXLEN=10000
FOOD_EMBEDDING_MAX_RETRIES=3

VLLM_EMBEDDING_ENDPOINT=http://edgexpert-starwind.local:8001/v1/embeddings
VLLM_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
VLLM_EMBEDDING_QUERY_INSTRUCTION=Given a user food preference query, retrieve the most relevant meal options that satisfy the requested cuisine, meal timing, price range, convenience, and extra dietary or taste hints.
VLLM_EMBEDDING_ENCODING_FORMAT=float
VLLM_EMBEDDING_TIMEOUT_SECONDS=30
VLLM_RERANK_ENDPOINT=http://edgexpert-starwind.local:8002/score
VLLM_RERANK_MODEL=Qwen3-Reranker-0.6B
VLLM_RERANK_INSTRUCTION=Given a user food preference query, judge whether the candidate food matches the requested cuisine, meal timing, price range, convenience, and extra taste or dietary hints.
VLLM_RERANK_TIMEOUT_SECONDS=30
VLLM_CHAT_ENDPOINT=http://edgexpert-starwind.local:8003/v1/chat/completions
VLLM_CHAT_MODEL=qwen3-coder-30b-a3b-instruct-fp8
VLLM_CHAT_MAX_TOKENS=4096
VLLM_CHAT_TIMEOUT_SECONDS=30

EMBEDDING_DIMENSIONS=1024
USE_CACHE=false

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_HASH_ALGORITHM=pbkdf2_sha256
PASSWORD_HASH_ITERATIONS=390000
PASSWORD_SALT_BYTES=16
